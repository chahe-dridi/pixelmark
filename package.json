{
  "name": "pixelmark-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pixelmark/site",
    "build": "npm run build -w pixelmark && npm run build -w @pixelmark/site",
    "build:lib": "npm run build -w pixelmark",
    "build:site": "npm run build -w @pixelmark/site",
    "preview": "npm run preview -w @pixelmark/site",
    "test": "npm test -w pixelmark",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
