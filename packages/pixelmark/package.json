{
  "name": "react-pixelmark",
  "version": "0.2.2",
  "description": "Animated pixel-art wordmarks for React: 19 classic pixel effects and 16 game & story cutscenes (Mario, Pac-Man, Street Fighter, Star Wars…) that build your text on a single canvas.",
  "type": "module",
  "license": "MIT",
  "author": "Chaher Dridi (https://github.com/chahe-dridi)",
  "homepage": "https://pixelmark-site.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chahe-dridi/pixelmark.git",
    "directory": "packages/pixelmark"
  },
  "bugs": {
    "url": "https://github.com/chahe-dridi/pixelmark/issues"
  },
  "keywords": [
    "react",
    "pixel-art",
    "wordmark",
    "logo",
    "animation",
    "canvas",
    "text-animation",
    "hero",
    "retro",
    "8-bit",
    "component"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && node scripts/copy-types.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "prepack": "node scripts/prepack.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
